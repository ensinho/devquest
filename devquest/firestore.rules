rules_version = '2';

// DevQuest — the browser may only READ its own player data.
// Every write goes through the Vercel API (Firebase Admin SDK), which
// re-validates quests, enforces XP rules, rate limits and records metadata.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;

      match /events/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /solutions/{questId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // account metadata, device fingerprints and rate-limit windows
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // stats, audit and anything not listed above: server only
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
